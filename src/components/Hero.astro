---
import { Image } from "astro:assets";
import portraitImage from "../assets/christian-rey-piape-muninn.avif";

// Vertical position of the photo inside the circle:
// 0 = top of the photo, 50 = centered, 100 = bottom of the photo.
const PORTRAIT_Y = 100;
const circleSize = "min(45vw, 280px)";
---

<section
  id="hero"
  class="relative flex flex-col md:flex-row min-h-svh md:h-svh overflow-hidden px-2 sm:px-5 pt-23 sm:pt-30 pb-5 sm:pb-4"
>
  <!--
    Phone: a column. The title group (portrait, name, tagline) is centered in the
    space above the paragraph. On short phones the hero grows taller than the
    screen instead of clipping. md and up: the original row, pinned to the bottom.
  -->
  <div
    class="relative z-10 flex w-full flex-1 flex-col gap-6 pt-6 md:mt-auto md:flex-none md:flex-row md:flex-wrap md:justify-between md:gap-10 md:pt-0"
  >
    <div class="my-auto flex flex-col gap-5 sm:gap-10 md:my-0">
      <!-- Mobile only: the cursor reveal is desktop-only, so show the portrait statically. -->
      <div
        class="shrink-0 self-center overflow-hidden rounded-full bg-black md:hidden"
        style={`width: ${circleSize}; height: ${circleSize}`}
        aria-hidden="true"
      >
        <Image
          src={portraitImage}
          alt=""
          width={960}
          widths={[320, 800, 960]}
          sizes={`(max-width: 767px) ${circleSize}, 1px`}
          quality={100}
          format="avif"
          loading="eager"
          fetchpriority="high"
          class="pointer-events-none h-full w-full object-cover"
          style={`object-position: 50% ${PORTRAIT_Y}%`}
        />
      </div>

      <h1 class="font-archivo text-[clamp(2rem,18vw,15rem)] sm:text-[clamp(2rem,15vw,15rem)] font-bold leading-[0.8]">
        Christian<br />Rey<br />Piape.
      </h1>
      <p class="text-xl sm:text-[clamp(1rem,3vw,2.75rem)] ml-2 sm:ml-4">
        zero tolerance for mediocrity.
      </p>
    </div>

    <div class="mx-auto sm:mx-0 text-center sm:text-left flex max-w-[35ch] sm:max-w-[45ch] text-sm sm:text-base">
      <p>
        Designing and developing modern websites for brands that refuse to conform.
        Every project is crafted with intention, engineered for performance,
        and shaped around your brand's identity.
      </p>
    </div>
  </div>
</section>